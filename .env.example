# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/leadflow?sslmode=require

# Evolution API
EVO_BASE_URL=http://localhost:8080
EVO_GLOBAL_API_KEY=your-evolution-master-key

# This app's own public URL (used to build each tenant's webhook URL)
PUBLIC_BASE_URL=https://your-app.vercel.app

# Protects /api/v1/tenants endpoints — only you should call these (MVP auth)
ADMIN_API_KEY=set-a-strong-random-string

# PayFast
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase-if-set-in-payfast-dashboard
PAYFAST_MODE=sandbox
