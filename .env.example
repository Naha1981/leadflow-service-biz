# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Evolution API
EVO_BASE_URL=http://localhost:8080
EVO_GLOBAL_API_KEY=your-evolution-master-key

# Your deployed backend URL (used to build each tenant's webhook URL)
PUBLIC_BASE_URL=https://yourdomain.com

# Protects /tenants endpoints — only you should call these
ADMIN_API_KEY=set-a-strong-random-string

# PayFast (South African payment gateway)
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-salt-passphrase
PAYFAST_MODE=sandbox
